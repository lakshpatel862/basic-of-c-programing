#include<stdio.h>
int main()
{
	//declare variables
	int num,i,isprime=1;
	printf("enter a positive number");
	scanf("%d",&num);
	
	if(num<2)
	{
		 isprime=0;
	}
	else
	{
		for(i=2;i<num;i++)
		{
			if(num%i==0)
            {
            	 isprime=0;
            	break;
			}  		
		}
		
	}
  if(isprime)
  {
  	printf("%d is a prime number",num);
  }
  else
  {
  	printf("%d is not a prime number",num);
  }
  return 0;
}

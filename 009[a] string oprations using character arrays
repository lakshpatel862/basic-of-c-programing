		printf("4.compare strings\n");
		printf("5.reverse string\n");
		printf("6.check palindrome\n");
		printf("0.exit\n");
		
		printf("enter your choice:");
		scanf("%d",&choice);
		
		switch (choice)
		{
			case 1:
			 length=0;
			 
			 while(str1[length]!='\0')
			 {
			 	length++;
			 }
			 printf("length of first string=%d\n",length);

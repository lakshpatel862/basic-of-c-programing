#include<stdio.h>
int main()
{
	char str1[100],str2[100];
	char combined[200];
	int i,j,length=0,choice,equal=1;
	
	printf("enter the first string:");
	scanf("%[^\n]",str1);
	
	printf("enter the second string:");
	scanf("%[^\n]",str2);
	

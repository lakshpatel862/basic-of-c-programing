			 case 2:
			 	
			 	i=0;
			 	
			 	while(str1[i]!='\0')
			 	{
			 		str2[i]=str1[i];
			 		i++;
				 }
				 
				 str2[i]='\0';
				 
				 printf("copied string=%s\n",str2);
				 break;
				 
				 case 3:
				 	i=0;
				 	
				 	while(str1[i]!='\0')
				 	{
				 		combined[i]=str1[i];
				 		i++;
					 }
					 
					 j=0;
					 while(str2[j]!='\0')
					 {
					 	combined[i]=str2[j];
					 	i++;
					 	j++;
					 }
					 
					 combined[i]='\0';
					 
					 printf("concatenated string=%s\n",combined);

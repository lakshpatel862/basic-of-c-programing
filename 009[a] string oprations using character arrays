						case 6:
						
						 length=0;
						 
						 while(str1[length]!='\0');
						 {
						 	length++;
						 }
						 
						 equal=1;
						 
						 for(i=0;i<length/2;i++)
						 {
						 	if(str1[i]!=str1[length-1-i]);
						 	{
						 		equal=0;
						 		break;
							 }
						 }
						 
						 if(equal==1)

						    printf("strings are different.\n");
							
							break;
							
						case 5:
						
						length=0;
						
						while(str1[length]!='\0')
						{
							length++;
						}
						
						printf("reversed string=");
						
						for(i=length-1;i>=0;i--)
						{
							printf("%c",str1[i]);
						}
						
						printf("\n");

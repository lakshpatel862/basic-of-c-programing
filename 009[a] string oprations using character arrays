					 case 4:
					 	i=0;
					 	equal=1;
					 	
					 	while(str1[i]!='0'||str2[i]!='\0')
					 	{
					 		if(str1[i]!=str2[i])
					 		{
					 			equal=0;
					 			break;
							 }
							 
							 i++;
						 }
						 
						 if (equal==1)
						    printf("both strings are equal.\n");
